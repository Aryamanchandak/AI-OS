# Template. Copy to .env for project-specific overrides.
# OPENAI_API_KEY and DEEPGRAM_API_KEY are pulled from the SHARED workspace env file
# (/Users/aryamanchandak/Documents/AI Code/.env), NOT from here.
#
# Shared file example:
# OPENAI_API_KEY=...
# DEEPGRAM_API_KEY=...

# --- Reasoning brain (Phase 0) ---
REACT_LOOP_MODEL=gpt-4o-mini

# --- MCP server (Phase 1) --- (defaults live in react_loop/config.py)
# MCP_SERVER_COMMAND=uv
# MCP_SERVER_ARGS=run --project /Users/aryamanchandak/Documents/AI Code/mcp_server python /Users/aryamanchandak/Documents/AI Code/mcp_server/mcp_server.py
# MCP_SERVER_CWD=/Users/aryamanchandak/Documents/AI Code/mcp_server

# --- Loop safety caps (Phase 3) ---
REACT_LOOP_MAX_ITERATIONS=15
REACT_LOOP_MAX_REPAIRS=3

# --- Logging ---
# REACT_LOOP_LOG_LEVEL=INFO      # DEBUG for full thoughts/args/timings
# REACT_LOOP_LOG_FILE=react_loop.log   # also write logs to this file

# --- Podcast feeds ---
# Curated feeds ship in podcast_tools/feeds.txt. Point at a different file to
# override the whole set:
# PODCAST_FEEDS_FILE=/path/to/feeds.txt

# --- Read-only website search ---
# Comma-separated domains only; no schemes, paths, ports, or wildcards.
# WEB_SEARCH_ALLOWED_DOMAINS=economist.com,bbc.com,bbc.co.uk
# The default allowlist is simple_server/allowed_websites.txt. Override its
# location only if you want to maintain the domain list elsewhere:
# WEB_SEARCH_ALLOWED_DOMAINS_FILE=/path/to/allowed_websites.txt
# Optional; keyless Semantic Scholar access also works at lower rate limits:
# SEMANTIC_SCHOLAR_API_KEY=...
