GEMINI_API_KEY=
DATABASE_URL=sqlite:///data/consequence_radar.db
WEB_HOST=127.0.0.1
WEB_PORT=8010
FAST_MODEL=gemini-2.5-flash
REASONING_MODEL=gemini-2.5-pro
REPORT_MODEL=gemini-2.5-pro
MAX_RESEARCH_CYCLES=3
MAX_GRAPH_NODES=24
MAX_GRAPH_EDGES=36
MAX_RESEARCH_TASKS_PER_CYCLE=8
MAX_SEARCH_QUERIES_PER_RUN=30
MAX_FETCHED_SOURCES_PER_RUN=50
MAX_MODEL_CALLS_PER_RUN=30
MAX_WALL_TIME_SECONDS=600
REPORT_CONTEXT_TOKEN_BUDGET=24000
REPORT_MIN_WORDS=800
REPORT_MAX_WORDS=1200
WORKER_COUNT=2
FETCH_RETRY_LIMIT=1

# Adds Gemini URL Context alongside Google Search grounding to populate real
# per-result relevance snippets (see README.md). Disable if it
# proves unreliable or expensive.
ENABLE_URL_CONTEXT_SEARCH=true
