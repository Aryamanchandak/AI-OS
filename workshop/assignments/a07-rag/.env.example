# Copy to .env and fill in. Never commit .env.

# Option 1: any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Option 2: leave the three above empty and set one of these
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: better web search. Without it the agent uses DuckDuckGo.
TAVILY_API_KEY=

# Embeddings. Gemini and OpenAI keys above work as they are. With an
# Anthropic or Groq key, set all three of these to a provider that embeds.
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=
