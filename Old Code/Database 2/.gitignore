# Python virtualenvs & caches
**/.venv/
**/__pycache__/
**/*.pyc
**/.mypy_cache/
**/.pytest_cache/

# Packaging / build artifacts (regenerable)
**/*.egg-info/
vector-db/build/

# Derived, disposable stores (rebuildable from bronze — see STORAGE_PRINCIPLES P1)
vector-db/chroma_store/

# SQLite runtime sidecar files (keep the .db, not the WAL/shm)
sqlite/*.db-shm
sqlite/*.db-wal

# Local scratch / verification artifacts
sqlite/_verification/
sqlite/_verification_artifacts.db*

# macOS
.DS_Store
**/.DS_Store
