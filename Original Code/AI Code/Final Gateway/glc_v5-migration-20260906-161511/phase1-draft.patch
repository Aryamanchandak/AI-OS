+def load_local_models() -> dict[str, dict]:
+    """Load and validate the separately addressable Ollama model catalogue."""
+    from glc import config as _config
+
+    path = _config.local_models_yaml_path()
+    raw = _config.load_yaml(path)
+    models = raw.get("models") or {}
+    if not isinstance(models, dict) or not models:
+        raise ValueError(f"{path}: `models` must be a non-empty mapping")
+    required = {"model", "needs_think_false", "vision", "context_window"}
+    out: dict[str, dict] = {}
+    for name, value in models.items():
+        if not isinstance(value, dict):
+            raise ValueError(f"{path}: models.{name} must be a mapping")
+        missing = sorted(required - value.keys())
+        if missing:
+            raise ValueError(f"{path}: models.{name} is missing {missing}")
+        spec = dict(value)
+        if env_name := spec.get("model_env"):
+            spec["model"] = os.getenv(str(env_name), str(spec["model"]))
+        if not isinstance(spec["context_window"], int) or spec["context_window"] <= 0:
+            raise ValueError(f"{path}: models.{name}.context_window must be a positive integer")
+        out[str(name)] = spec
+    return out
+
