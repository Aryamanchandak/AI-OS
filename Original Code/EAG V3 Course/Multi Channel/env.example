# Copy to .env and fill in:  cp env.example .env
# .env is gitignored — never commit real values.

ANTHROPIC_API_KEY=
HOME_TIMEZONE=Asia/Kolkata

# --- Telegram: TWO bots (see DESIGN.md 2.1b) --------------------------------
# Control bot = approval buttons. Its chat is excluded from ingestion so your
# own taps are never re-ingested as inbound mail.
TELEGRAM_CONTROL_BOT_TOKEN=
TELEGRAM_CONTROL_CHAT_ID=
TELEGRAM_INBOX_BOT_TOKEN=

# --- Gmail (Phase 1) --------------------------------------------------------
# Download OAuth client from Google Cloud Console -> credentials.json
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# --- Slack (Phase 4) --------------------------------------------------------
# User token (im:history) for DM coverage; bot scopes only see channels.
SLACK_USER_TOKEN=
SLACK_APP_TOKEN=

# --- Twilio SMS (Phase 5) ---------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_POLL_MODE=true

# --- WhatsApp (Phase 6, needs a public HTTPS tunnel) ------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
