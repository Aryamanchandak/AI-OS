  "components": {
    "schemas": {
      "BudgetSetRequest": {
        "properties": {
          "principal": {
            "type": "string",
            "title": "Principal",
            "description": "e.g. \"session:run-42\" or \"agent:*\""
          },
          "limit_usd": {
            "type": "number",
            "minimum": 0.0,
            "title": "Limit Usd"
          },
          "period": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "minute",
                  "hour",
                  "day",
                  "month",
                  "lifetime"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          },
          "include_errors": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Include Errors"
          }
        },
        "type": "object",
        "required": [
          "principal",
          "limit_usd"
        ],
        "title": "BudgetSetRequest",
        "description": "POST /api/llm/budget \u2014 arm or move a ceiling at runtime.\n\n`principal` is \"<dimension>:<value-or-glob>\" over the two attribution\ndimensions (agent, session). A runtime entry shadows\na same-named entry in budgets.yaml, so an operator can clamp a runaway\nsession without a deploy, and `limit_usd: 0` refuses everything for that\nprincipal immediately."
      },
      "CacheableSystemBlock": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "cache": {
            "type": "boolean",
            "title": "Cache",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CacheableSystemBlock"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Messages"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt"
          },
          "system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/CacheableSystemBlock"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "System"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile"
          },
          "max_tokens": {
            "type": "integer",
            "title": "Max Tokens",
            "default": 2048
          },
          "temperature": {
            "type": "number",
            "title": "Temperature",
            "default": 0.7
          },
          "stream": {
            "type": "boolean",
            "const": false,
            "title": "Stream",
            "default": false
          },
          "tools": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ToolDef"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tools"
          },
          "tool_choice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Choice"
          },
          "cache_system": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cache System"
          },
          "reasoning": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "off",
                  "low",
                  "medium",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning"
          },
          "response_format": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResponseFormat"
              },
              {
                "type": "null"
              }
            ]
          },
          "agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent"
          },
          "session": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ChatRequest",
        "description": "Chat input with explicit model/profile selection and agent/session attribution."
      },
      "EmbedRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "retrieval_document",
              "retrieval_query"
            ],
            "title": "Task Type",
            "default": "retrieval_document"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "EmbedRequest",
        "description": "Request for POST /api/llm/embed. The model is fixed per deployment (see\nREADME); only the text, task type, and an optional explicit provider\nare caller-controlled."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
